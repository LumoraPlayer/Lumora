<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Benchmark-only source set: this manifest is merged into the `benchmark` build type
         and never into release. profileable is what lets macrobenchmark capture a release-
         like process; the seed activity imports the synthetic catalogue once. -->
    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <activity
            android:name=".benchmark.BenchmarkSeedActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true" />
    </application>
</manifest>
