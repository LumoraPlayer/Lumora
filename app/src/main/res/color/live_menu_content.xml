<!-- Live TV dropdown row content: the selected pane keeps the brand tint, the focused row
     goes full-strength text, and the rest stay quiet. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_selected="true"
        android:color="@color/primary_light" />
    <item
        android:state_focused="true"
        android:color="@color/text_primary" />
    <item android:color="@color/text_secondary" />
</selector>
