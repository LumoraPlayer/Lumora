<!-- One locality row in Settings > Regions. Matches the CheckBox rows in the Filters pane
     so the picker reads as part of the same screen rather than a bolted-on dialog. -->
<CheckBox xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/localityCheck"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/settings_gap"
    android:paddingVertical="@dimen/settings_row_padding_vertical"
    android:background="@drawable/card_surface_background"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/focus_scale_flat"
    android:textColor="@color/text_primary"
    android:textSize="@dimen/settings_text_body"
    android:fontFamily="@font/inter_medium"
    android:clipChildren="false"
    android:clipToPadding="false"/>
