<!-- Person (actor/director) search result tile. Sized exactly like item_poster_grid and
     item_epg_result - same outer margin and search_poster_image_height artwork area - so a
     name search can sit in the same results grid as titles. The portrait fills the tile;
     "Known for ..." and the name are drawn over the bottom scrim, matching the poster
     title treatment. The PERSON pill marks it as a credits match rather than a title. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_poster_focus_ring"
    android:stateListAnimator="@animator/focus_scale"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/personPosterFrame"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_poster_image_height"
        android:background="@drawable/bg_rounded_poster_large"
        android:clipToOutline="true">

        <com.lumora.ui.RoundedImageView
            android:id="@+id/personPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:cornerRadius="@dimen/poster_image_corner_radius" />

        <View
            android:id="@+id/personPosterScrim"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_gravity="bottom"
            android:background="@drawable/grad_poster_scrim" />
    </FrameLayout>

    <TextView
        android:id="@+id/personBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:background="@drawable/pill_live"
        android:backgroundTint="@color/primary"
        android:fontFamily="@font/inter_semibold"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:textAllCaps="true"
        android:textColor="@android:color/white"
        android:textSize="@dimen/poster_badge_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- "Known for Breaking Bad, ..." - single line, smaller type than the name. -->
        <com.lumora.ui.OutlineTextView
            android:id="@+id/personMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            app:outlineColor="@color/poster_title_outline"
            app:outlineWidth="@dimen/poster_title_outline_width" />

        <!-- The person's name: the prominent line, same auto-sized outlined treatment as
             poster titles so it stays readable over a bright portrait. -->
        <com.lumora.ui.OutlineTextView
            android:id="@+id/personName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="@dimen/poster_title_text"
            android:autoSizeMinTextSize="@dimen/poster_title_text_min"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="simple"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/poster_title_text"
            app:outlineColor="@color/poster_title_outline"
            app:outlineWidth="@dimen/poster_title_outline_width" />
    </LinearLayout>
</FrameLayout>
