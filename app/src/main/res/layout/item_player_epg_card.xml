<!-- One programme in the player's now/next rail. Two lines only - slot/status and title -
     because the bar is deliberately half its old height and the full listing (description,
     duration, relative start, reminder) lives in the details panel an OK press opens.
     Selected marks the programme actually airing, focused is where the D-pad is - the
     selector gives focused priority so the two never fight over the same border. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/player_epg_card_width"
    android:layout_height="@dimen/player_epg_card_height"
    android:layout_marginEnd="@dimen/player_epg_card_gap"
    android:background="@drawable/bg_player_epg_card"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:nextFocusDown="@id/btnPlayPause"
    android:orientation="vertical"
    android:paddingHorizontal="9dp"
    android:paddingVertical="5dp">

    <TextView
        android:id="@+id/epgCardTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/player_epg_time_text" />

    <TextView
        android:id="@+id/epgCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/player_epg_title_text" />
</LinearLayout>
