<!-- Category rows deliberately do NOT scale on focus. A 1.06x row overflows the narrow
     sidebar by ~6dp per side, and the list clips at its bounds - keeping enough margin for
     that overflow made the focus outline sit far from the rail's edge. The row's focus state
     is the 3dp outline from bg_select_item instead, so a slim 2dp margin is enough and the
     outline can hug the panel.

     maxLines is category_row_max_lines (2, 3 on a portrait phone), not 1: the sidebar gives
     ~168dp of text at 14sp bold - about 21 characters -
     and provider category names ("SWEDEN TV 4 PLAY PPV VIP", "4K DOCUMENTARY/MUSIC/STAND-UP")
     routinely run past that, leaving rows that ellipsise down to near-identical prefixes.
     Wrapping roughly doubles what is readable without taking a single dp off the poster grid,
     which is what widening the rail would cost instead. The row is wrap_content, so it only
     grows for the names that actually need the second line.

     The row root is now a container: the star (white when the category is pinned, grey when
     not) is its own D-pad target next to the label, so pinning is one press away instead of
     a long-press context menu. The container keeps the selectable/focusable chrome - the
     star is a sibling, not a child of the label. -->
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/categoryRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2dp"
        android:layout_marginVertical="3dp"
        android:background="@drawable/bg_select_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/category_row_padding_horizontal"
        android:paddingVertical="@dimen/category_row_padding_vertical"
        android:stateListAnimator="@null"
        android:nextFocusLeft="@id/categoryStar"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- ★ white when the category is pinned, ☆ grey when not. Sits before the name, as
             its own D-pad target: LEFT from the row lands on it, OK toggles the pin. The
             adapter hides it for rows that can't be pinned (the "All" row, toggle rows) -
             a dead star reads as a broken one. -->
        <ImageView
            android:id="@+id/categoryStar"
            android:layout_width="@dimen/category_star_size"
            android:layout_height="@dimen/category_star_size"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_toolbar_button"
            android:clickable="true"
            android:contentDescription="@string/pin_category"
            android:focusable="true"
            android:nextFocusRight="@id/categoryRow"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_star"
            android:stateListAnimator="@animator/focus_scale_flat"
            android:tint="@color/text_secondary"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/categoryLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:maxLines="@integer/category_row_max_lines"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/category_row_text" />
    </LinearLayout>
