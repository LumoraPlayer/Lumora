<!-- The SMB/WebDAV browse screen. It fills the settings slot above the settings dialog so
     leaving the player lands back in the folder being browsed, and Back at the share root
     reveals Settings again (see MainActivityShares.showShareBrowser). Opaque background:
     the dialog underneath must not show through a file listing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical"
    android:padding="@dimen/settings_gap_l">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/shareBrowserUp"
            style="@style/Widget.Lumora.SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/settings_action_button_height"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="@dimen/settings_gap"
            android:stateListAnimator="@animator/focus_scale_flat"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_up"
                android:textColor="@color/primary_light"
                android:textSize="@dimen/settings_text_caption"
                android:fontFamily="@font/inter_medium" />
        </LinearLayout>

        <TextView
            android:id="@+id/shareBrowserPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/settings_gap"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/settings_text_body"
            android:fontFamily="@font/inter_medium" />

        <LinearLayout
            android:id="@+id/shareBrowserClose"
            style="@style/Widget.Lumora.SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/settings_action_button_height"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="@dimen/settings_gap"
            android:stateListAnimator="@animator/focus_scale_flat"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_close"
                android:textColor="@color/primary_light"
                android:textSize="@dimen/settings_text_caption"
                android:fontFamily="@font/inter_medium" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/shareBrowserStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_gap"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/settings_text_caption"
        android:fontFamily="@font/inter_regular"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/settings_gap"
        android:layout_weight="1"
        android:clipChildren="false"
            android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/shareBrowserList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="@dimen/settings_gap_l" />
    </ScrollView>
</LinearLayout>
