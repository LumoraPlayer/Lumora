<!-- Season chip cell: the label keeps all the chip chrome (bg_season_chip, focus
     ring, selected state) and its click selects the season - unchanged. The check
     is a sibling appended to the right of the label: its click toggles watched/
     unwatched for the whole season. The container itself is not focusable - both
     children are their own D-pad targets, and LEFT/RIGHT between them is wired via
     OnKeyListener in MainActivity (default focus search won't cross a focusable
     child at the chip's edge). clipChildren/clipToPadding false on the cell so the
     focus ring isn't sliced by the cell's own bounds; the HorizontalScrollView
     hosting the row already sets the same.

     Both children grow through the season_chip_* dimens on a TV: the selector sits
     under a row of 19sp episode titles, so a 14sp label in a 30dp pill read as the
     smallest control on the page. No focus-scale animator on either child - both
     drawables already ring on focus, and any scale-up overflows the horizontally
     clipped chip scroller. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/seasonChipLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_season_chip"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:fontFamily="@font/inter_medium"
        android:maxLines="1"
        android:maxWidth="@dimen/season_chip_max_width"
        android:paddingHorizontal="@dimen/season_chip_padding_horizontal"
        android:paddingVertical="@dimen/season_chip_padding_vertical"
        android:textColor="@color/season_chip_text"
        android:textSize="@dimen/text_body_s" />

    <!-- Green-filled when every episode in the season is watched, hollow outline
         otherwise. Shared drawable/color with the episode-row check so both read as
         the same "mark watched" control. -->
    <TextView
        android:id="@+id/seasonCheckButton"
        android:layout_width="@dimen/season_chip_check_size"
        android:layout_height="@dimen/season_chip_check_size"
        android:layout_marginStart="@dimen/season_chip_gap"
        android:background="@drawable/bg_episode_check"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/episode_check_text"
        android:textSize="@dimen/text_body_l" />
</LinearLayout>
