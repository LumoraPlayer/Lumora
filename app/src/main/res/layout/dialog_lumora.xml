<!-- The one dialog layout in the app. Every alert, confirmation, picker and input popup is
     inflated from here by LumoraDialog, so the panel, type, focus ring and button shapes are
     the app's own on every ROM - never the platform's alert layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lumoraDialogPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_category_panel"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="24dp"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/lumoraDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:visibility="gone" />

    <com.lumora.view.BoundedHeightScrollView
        android:id="@+id/lumoraDialogMessageScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fadeScrollbars="true"
        android:scrollbars="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/lumoraDialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_subhead" />
    </com.lumora.view.BoundedHeightScrollView>

    <!-- Caller-built content (forms, QR cards, progress blocks). Hidden when a choice list
         supplies the content instead. -->
    <com.lumora.view.BoundedHeightScrollView
        android:id="@+id/lumoraDialogContentScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fadeScrollbars="true"
        android:scrollbars="vertical"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/lumoraDialogContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.lumora.view.BoundedHeightScrollView>

    <!-- The list lives inside a clipping frame: a RecyclerView that is scrolled draws its
         first visible row from its own top edge upwards (the row carries a focus-scale
         transform), and with the panel's clipChildren=false that row painted over the title
         above the list. The frame clips the whole list subtree to the list's bounds. It has
         no height of its own, so dialogs without a list are unaffected. -->
    <FrameLayout
        android:id="@+id/lumoraDialogChoiceFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="true"
        android:clipToPadding="true">

        <com.lumora.ui.dialog.DialogChoiceList
            android:id="@+id/lumoraDialogChoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/lumoraDialogButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/lumoraDialogNeutral"
            style="@style/Widget.Lumora.DialogButton"
            android:text="@string/cancel"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lumoraDialogNegative"
            style="@style/Widget.Lumora.DialogButton"
            android:text="@string/cancel"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lumoraDialogPositive"
            style="@style/Widget.Lumora.DialogButton.Primary"
            android:text="@string/cancel"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
