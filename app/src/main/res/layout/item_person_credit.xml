<!-- One title in a person's "Known for" row on the cast member page. Built on the shelf
     poster's metrics and card chrome (same width/height dimens, same scrim and outlined
     title), so the filmography reads as the same kind of poster everywhere else in the
     app; the year/role line is what the shelves have no equivalent of. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/shelf_poster_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:background="@drawable/bg_grid_card"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp"
    android:stateListAnimator="@animator/focus_scale">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/shelf_poster_image_height"
        android:background="@color/surface">

        <ImageView
            android:id="@+id/creditPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:background="@drawable/grad_poster_scrim" />

        <com.lumora.ui.OutlineTextView
            android:id="@+id/creditTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:padding="8dp"
            android:autoSizeMaxTextSize="@dimen/poster_title_text"
            android:autoSizeMinTextSize="@dimen/poster_title_text_min"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="simple"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:lineSpacingExtra="1dp"
            android:maxLines="3"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/poster_title_text"
            app:outlineColor="@color/poster_title_outline"
            app:outlineWidth="@dimen/poster_title_outline_width" />
    </FrameLayout>

    <!-- "2013 · as Walter White" - the year, and the part played where TMDB states one. -->
    <TextView
        android:id="@+id/creditMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_regular"
        android:maxLines="1"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_tiny" />
</LinearLayout>
