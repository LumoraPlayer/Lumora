<!-- clipChildren/clipToPadding false: this row and episodeDownloadButton both scale to
     1.06x on focus - without this the scale-up gets clipped by this row's own bounds
     (episodeDownloadButton hugs the right edge) and by the RecyclerView hosting it.
     The detail screen's padded containers need the same, or the row is sliced at the
     screen edges instead. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/episode_row_gap"
    android:background="@drawable/bg_channel_row"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/episode_row_min_height"
    android:orientation="horizontal"
    android:padding="@dimen/episode_row_padding"
    android:stateListAnimator="@animator/focus_scale_row">

    <!-- 16:9, matching the aspect the providers' episode stills actually come in, so
         centerCrop isn't shaving the sides off every thumbnail. The size is a dimen so
         the still can grow with the TV type scale instead of staying at phone size. -->
    <FrameLayout
        android:layout_width="@dimen/episode_thumb_width"
        android:layout_height="@dimen/episode_thumb_height"
        android:background="@drawable/bg_rounded_poster"
        android:clipToOutline="true">

        <com.lumora.ui.RoundedImageView
            android:id="@+id/episodeThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:cornerRadius="@dimen/detail_image_corner_radius" />

        <!-- Always-visible play affordance, not just an unfocused static icon - a
             wash-toned circle wasn't reading as clickable/playable at TV viewing
             distance ("no play button" - the icon existed but was too faint/small
             to register as one). -->
        <ImageView
            android:id="@+id/episodePlayIcon"
            android:layout_width="@dimen/episode_play_icon_size"
            android:layout_height="@dimen/episode_play_icon_size"
            android:layout_gravity="center"
            android:background="@drawable/bg_play_circle_overlay"
            android:padding="8dp"
            android:src="@drawable/ic_play"
            android:tint="@android:color/white" />

        <TextView
            android:id="@+id/episodeWatchedBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_episode_watched_badge"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_body_s"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Continue-watching progress: how far into this episode the last session got,
             mirroring the same signal the Home tab's Continue Watching shelf shows, but
             at the point of actually picking an episode instead of only surfacing it a
             tab away. -->
        <ProgressBar
            android:id="@+id/episodeProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progressDrawable="@drawable/progress_episode_resume"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Episode number leads the title line as its own coloured token rather than
             sitting in a corner badge on the thumbnail, where it fought the play icon
             for the same small still and was too small to read across a room. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/episodeNumberBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:minWidth="34dp"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:background="@drawable/bg_episode_number_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/primary_light"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/episodeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_subhead_l" />
        </LinearLayout>

        <!-- Air date and resume position share one quiet meta line under the title. The
             date used to sit at the far right of the title line, hundreds of dp away from
             the title it described; the resume label used to get a whole line of its own.
             One line keeps both attached to the title and leaves more width for it. -->
        <LinearLayout
            android:id="@+id/episodeMetaRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/episodeDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/episodeMetaDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:text="·"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />

            <TextView
                android:id="@+id/episodeResumeLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:maxLines="1"
                android:textColor="@color/primary_light"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/episodePlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Focusable is NOT set here: EpisodeAdapter.bind drives it from the enabled state -
         a disabled button (episode already downloaded) must stay out of the D-pad chain. -->
    <ImageButton
        android:id="@+id/episodeDownloadButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_toolbar_button"
        android:clickable="true"
        android:contentDescription="@string/episode_download"
        android:padding="9dp"
        android:src="@android:drawable/stat_sys_download"
        android:stateListAnimator="@animator/focus_scale"
        android:tint="@color/text_secondary"
        android:visibility="gone"
        android:clipChildren="false"
    android:clipToPadding="false"/>

    <!-- Watched-state toggle - the checkmark IS the control. Filled green when the
         episode is watched, hollow outline otherwise (state_selected drives both this
         background and the glyph tint). Always visible: at TV distance a badge alone
         doesn't read as actionable, and this is the only affordance for marking.
         The row's itemView focuses as a whole; LEFT/RIGHT between row and check is
         wired via OnKeyListener in EpisodeAdapter (default focus search won't reach a
         child at the row's edge - see the categoryStar pattern for the same reason). -->
    <TextView
        android:id="@+id/episodeCheckButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_episode_check"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:stateListAnimator="@animator/focus_scale_flat"
        android:text="✓"
        android:textColor="@color/episode_check_text"
        android:textSize="@dimen/text_subhead"
        android:clipChildren="false"
    android:clipToPadding="false"/>
</LinearLayout>
