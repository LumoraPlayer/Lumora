<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/shelf_poster_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:foreground="@drawable/bg_poster_focus_ring"
    android:stateListAnimator="@animator/focus_scale">

    <!-- The artwork is the card now: no inset surface frame around it. The rounded frame
         still clips the bitmap and the focus ring is drawn over the picture. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/shelf_poster_image_height"
        android:background="@drawable/bg_rounded_poster_large"
        android:clipToOutline="true">

        <com.lumora.ui.RoundedImageView
            android:id="@+id/itemPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:cornerRadius="@dimen/poster_image_corner_radius" />

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="bottom"
            android:background="@drawable/grad_poster_scrim" />

        <!-- Resume position, when the title has one. Sits on the artwork's bottom edge so
             Continue Watching and partially-watched titles read at a glance. -->
        <ProgressBar
            android:id="@+id/itemProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressDrawable="@drawable/progress_poster_resume"
            android:visibility="gone" />

        <!-- Three lines, not four: the overlay is a caption, not a synopsis. Four lines
             swallowed the bottom half of the artwork and forced the auto-sizer down to
             the floor on almost every long title; two clipped titles like
             "Another Movie (2025)" that the narrow shelf card genuinely needs. -->
        <com.lumora.ui.OutlineTextView
            android:id="@+id/itemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:padding="8dp"
            android:autoSizeMaxTextSize="@dimen/poster_title_text"
            android:autoSizeMinTextSize="@dimen/poster_title_text_min"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="simple"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:lineSpacingExtra="1dp"
            android:maxLines="3"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/poster_title_text"
            app:outlineColor="@color/poster_title_outline"
            app:outlineWidth="@dimen/poster_title_outline_width" />
    </FrameLayout>
</FrameLayout>
