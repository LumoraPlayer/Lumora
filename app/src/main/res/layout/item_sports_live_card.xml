<!-- A game in play, as a half-width card: the Live now section lays these two to a line, so a
     busy afternoon's live list is a screenful rather than a scroll of full-width bars.

     Same widgets and the same ids as item_sports_event.xml - SportsAdapter binds both through
     one holder, exactly as it binds fixture rows and guide rows through one already - but
     arranged for half the width. The scoreboard keeps the width (kick-off and state on the
     first line, the two sides stacked, each with its score box), and the competition moves
     down to share the last line with the channel chip instead of holding a column of its own.
     A full-width row reads down a table; a card this size has no table to read down, only
     itself.

     One D-pad target, the same as the full-width row: OK watches the matched channel, or opens
     the chooser when the guide matched the game to several.

     clipChildren/clipToPadding false because the card scales to 1.06x on focus (focus_scale)
     and would otherwise be sliced by its own bounds.

     Laid out as tight as the type allows - every gap here is 2-4dp and the chip's logo is a
     size below the full-width row's - because the box's size is what the board is read
     against: the air belongs in the gutter between two cards and the gap under one, not inside
     them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/sports_row_gap"
    android:background="@drawable/bg_channel_row"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp"
    android:stateListAnimator="@animator/focus_scale">

    <!-- Kick-off, with the state pill beside it. Only the live pill's solid colour ever lands
         here (the section is live by definition), which is the one thing worth spotting from
         across the room - and there is no column for it to hold in a card this narrow. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sportsTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_subhead" />

        <TextView
            android:id="@+id/sportsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_sports_neutral_pill"
            android:ellipsize="end"
            android:fontFamily="@font/inter_semibold"
            android:maxLines="1"
            android:paddingHorizontal="7dp"
            android:paddingVertical="1dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The two sides, each with its score box: what the card is for, so it keeps the width
         the full-width row gives its middle column. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sportsHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_l" />

        <TextView
            android:id="@+id/sportsHomeScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_sports_score"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:minWidth="@dimen/sports_score_box_min_width"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_l" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sportsAway"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_l" />

        <TextView
            android:id="@+id/sportsAwayScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_sports_score"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:minWidth="@dimen/sports_score_box_min_width"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_l" />
    </LinearLayout>

    <!-- Competition and channel on one line: which league, and where to watch it. The league is
         the one that gives way (weight 1, ellipsised) - the channel is what OK plays. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sportsLeague"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_caption" />

        <LinearLayout
            android:id="@+id/sportsChannelChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_sports_channel_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="7dp"
            android:paddingVertical="4dp">

            <FrameLayout
                android:id="@+id/sportsChannelLogoBox"
                android:layout_width="@dimen/sports_live_logo_size"
                android:layout_height="@dimen/sports_live_logo_size"
                android:background="@drawable/shape_logo_box">

                <TextView
                    android:id="@+id/sportsChannelInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_tiny" />

                <ImageView
                    android:id="@+id/sportsChannelLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Name and number on one line, baselines aligned: stacking them (as the full-width
                 row does) makes the chip the tallest thing on the card, when on a card it is a
                 footnote. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sportsChannelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_semibold"
                    android:maxLines="1"
                    android:maxWidth="@dimen/sports_live_channel_name_max_width"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/sportsChannelNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_gravity="center_vertical"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="@dimen/sports_live_channel_name_max_width"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
