<!-- One sport filter chip on the Sports board - the same pill the season selector uses
     (bg_season_chip: solid brand fill when selected, outline otherwise), because this is the same
     kind of control: the current choice among several, laid out in a scrolling row.

     A step below the season selector's scale - the chip row filters the board rather than being
     part of it, and six sports at full label size took the width of the whole screen - but only
     a step: at ten feet the pill still has to read as a label and a count, so this is a
     comfortable control size, not a caption. The icon is the sport's own glyph.

     The chip is the focus/click target rather than either child: a row of two-focus-target pills
     inside a timeline is the shape that makes D-pad navigation go wrong on these boxes, and the
     children duplicate the parent's state so the glyph tints with the label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sportsFilterChip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_season_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="7dp"
    android:stateListAnimator="@animator/focus_scale"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/sportsFilterChipIcon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginEnd="6dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:tint="@color/season_chip_text" />

    <TextView
        android:id="@+id/sportsFilterChipLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontFamily="@font/inter_medium"
        android:maxLines="1"
        android:textColor="@color/season_chip_text"
        android:textSize="@dimen/text_body" />
</LinearLayout>
