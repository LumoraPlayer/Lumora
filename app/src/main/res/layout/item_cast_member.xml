<!-- One face in the detail screen's cast row. The whole cell is the focus target and the
     click target (the face, name and role are one thing to a D-pad), and it wears the same
     card chrome as the filmography tiles it sits one step away from (bg_grid_card), so the
     two halves of the cast feature read as one component family - the sidebar's
     bg_select_item defaults to transparent and left the faces floating chrome-less. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/cast_cell_width"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:background="@drawable/bg_grid_card"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="@dimen/cast_photo_size"
        android:layout_height="@dimen/cast_photo_size"
        android:background="@drawable/bg_rounded_poster"
        android:clipToOutline="true">

        <com.lumora.ui.RoundedImageView
            android:id="@+id/castPhotoImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:cornerRadius="@dimen/small_image_corner_radius" />

        <!-- Visible until a profile URL loads (and forever for a person TMDB has no shot
             of), on the frame's own surface colour so an absent face reads as deliberate. -->
        <ImageView
            android:id="@+id/castPhotoPlaceholder"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_person" />
    </FrameLayout>

    <TextView
        android:id="@+id/castName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/cast_name_text" />

    <!-- The role in this title ("Walter White"). Optional: plenty of cast entries carry no
         character name, and the row keeps a one-line slot for the ones that do so the
         faces stay aligned. -->
    <TextView
        android:id="@+id/castCharacter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/cast_role_text" />
</LinearLayout>
