<!-- One folder or media file in the share browser: name on the left, size / FOLDER on the
     right. The whole row is the D-pad target (same treatment as the provider list rows). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/card_surface_background"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_action_button_height"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/settings_gap"
    android:paddingVertical="@dimen/settings_gap_s"
    android:stateListAnimator="@animator/focus_scale_flat">

    <TextView
        android:id="@+id/shareRowName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_text_body"
        android:fontFamily="@font/inter_medium" />

    <TextView
        android:id="@+id/shareRowDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_gap"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/settings_text_caption"
        android:fontFamily="@font/inter_regular" />
</LinearLayout>
