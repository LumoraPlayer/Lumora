<!-- Dropdown hung under the Live TV tab: the Live pane itself, Multiview (browse Live TV to
     add the next screen of the grid), and Catch Up (the same catalogue shifted back in
     time). Catch Up used to be a chip under the tab row, which cost every Live TV screen a
     band of height; as a dropdown it costs nothing until it is opened.

     Its own opaque panel rather than the player side menu's translucent glass: over the
     guide, the glass let channel names and artwork show through the labels. Rows are 48dp
     remote targets, and the currently active pane carries a selected row. Hosted in a
     focusable PopupWindow, so the D-pad walks these rows in their own window and BACK
     closes it - the tab bar's focus chain is untouched. Multiview sits above Catch Up;
     either row can be hidden when it has nothing behind it (no archive channels /
     multiview switched off), so the focus chain below points at its neighbours in the full
     three-row shape and the code re-links the first/last visible row at open time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/live_menu_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_live_menu_panel"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="10dp"
    android:orientation="vertical"
    android:outlineProvider="background"
    android:padding="@dimen/live_menu_padding">

    <LinearLayout
        android:id="@+id/liveMenuLive"
        android:layout_width="match_parent"
        android:layout_height="@dimen/live_menu_row_height"
        android:background="@drawable/bg_live_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:nextFocusUp="@id/liveMenuCatchup"
        android:nextFocusDown="@id/liveMenuMultiview"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/live_menu_row_padding_horizontal"
        android:stateListAnimator="@animator/focus_scale"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:layout_width="@dimen/live_menu_icon"
            android:layout_height="@dimen/live_menu_icon"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_live_tv"
            app:tint="@color/live_menu_content" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/live_menu_icon_gap"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:maxLines="1"
            android:text="@string/tab_live_tv"
            android:textColor="@color/live_menu_content"
            android:textSize="@dimen/live_menu_text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/liveMenuMultiview"
        android:layout_width="match_parent"
        android:layout_height="@dimen/live_menu_row_height"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_live_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:nextFocusUp="@id/liveMenuLive"
        android:nextFocusDown="@id/liveMenuCatchup"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/live_menu_row_padding_horizontal"
        android:stateListAnimator="@animator/focus_scale"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:layout_width="@dimen/live_menu_icon"
            android:layout_height="@dimen/live_menu_icon"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_multiview"
            app:tint="@color/live_menu_content" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/live_menu_icon_gap"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:maxLines="1"
            android:text="@string/mv_multiview"
            android:textColor="@color/live_menu_content"
            android:textSize="@dimen/live_menu_text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/liveMenuCatchup"
        android:layout_width="match_parent"
        android:layout_height="@dimen/live_menu_row_height"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_live_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:nextFocusUp="@id/liveMenuMultiview"
        android:nextFocusDown="@id/liveMenuLive"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/live_menu_row_padding_horizontal"
        android:stateListAnimator="@animator/focus_scale"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:layout_width="@dimen/live_menu_icon"
            android:layout_height="@dimen/live_menu_icon"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_catchup"
            app:tint="@color/live_menu_content" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/live_menu_icon_gap"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:maxLines="1"
            android:text="@string/tab_catchup"
            android:textColor="@color/live_menu_content"
            android:textSize="@dimen/live_menu_text" />
    </LinearLayout>
</LinearLayout>
