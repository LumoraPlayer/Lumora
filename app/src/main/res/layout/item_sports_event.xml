<!-- One fixture on the Sports board, laid out as a scoreboard rather than a sentence:
     kick-off and state in a fixed left column, the two sides stacked with their scores in
     matching boxes, the competition beneath them, and the channel carrying the game as a
     chip on the right.

     Every column is fixed or weighted so the board reads down as a table: times, team names,
     score boxes and chips all line up from row to row. The whole row is a single D-pad target
     (OK watches the channel, or opens the chooser when the guide matched more than one) -
     chips inside rows would put a second set of focus targets inside a list row, which is the
     focus-search shape that goes wrong on these boxes.

     clipChildren/clipToPadding false because the row scales to 1.06x on focus (focus_scale)
     and would otherwise be sliced top/bottom by its own bounds.

     The Live now section does not use this row: its games are half-width cards, two to a line,
     in item_sports_live_card.xml - the same scoreboard, arranged for half the width. Everything
     else on the board (this row) keeps the full width, which is the only shape a table reads
     down. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/sports_row_gap"
    android:background="@drawable/bg_channel_row"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/sports_row_min_height"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:stateListAnimator="@animator/focus_scale">

    <!-- Kick-off, with the state pill under it once there is one (LIVE 67', FT, Postponed). -->
    <LinearLayout
        android:layout_width="@dimen/sports_time_column_width"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sportsTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_subhead" />

        <TextView
            android:id="@+id/sportsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_sports_neutral_pill"
            android:ellipsize="end"
            android:fontFamily="@font/inter_semibold"
            android:maxLines="1"
            android:paddingHorizontal="7dp"
            android:paddingVertical="1dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The two sides, each with its score box, and the competition underneath. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sportsHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_l" />

            <TextView
                android:id="@+id/sportsHomeScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_sports_score"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:minWidth="@dimen/sports_score_box_min_width"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_l" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sportsAway"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_l" />

            <TextView
                android:id="@+id/sportsAwayScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_sports_score"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:minWidth="@dimen/sports_score_box_min_width"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_l" />
        </LinearLayout>

        <TextView
            android:id="@+id/sportsLeague"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <!-- The channel the guide says is carrying it. A dashed, empty chip when the guide knows
         of none: the honest answer, and still a chip so the column stays aligned. -->
    <LinearLayout
        android:id="@+id/sportsChannelChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_sports_channel_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <FrameLayout
            android:id="@+id/sportsChannelLogoBox"
            android:layout_width="@dimen/sports_logo_size"
            android:layout_height="@dimen/sports_logo_size"
            android:background="@drawable/shape_logo_box">

            <TextView
                android:id="@+id/sportsChannelInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <ImageView
                android:id="@+id/sportsChannelLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sportsChannelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_semibold"
                android:maxLines="1"
                android:maxWidth="@dimen/sports_channel_name_max_width"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/sportsChannelNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="@dimen/sports_channel_name_max_width"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
