<!-- Section label on the Sports board: "Live now", "Upcoming", "Finished". A red dot marks
     the section holding games actually in play, which is the one thing worth finding at a
     glance on a board this long. Not focusable: it is a label above the rows it groups. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="20dp"
    android:paddingBottom="6dp">

    <View
        android:id="@+id/sportsHeaderDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/bg_live_dot"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sportsHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/inter_semibold"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body_s" />

    <TextView
        android:id="@+id/sportsHeaderCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="@font/inter_medium"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_body_s" />
</LinearLayout>
