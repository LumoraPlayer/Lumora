<!-- The same chip, empty: a dashed outline where a channel would be. Reads as "nothing here
     yet" rather than as a broken chip, and keeps the column's width so every row's teams
     still end on the same line. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/color_border"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <corners android:radius="10dp" />
</shape>
