<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused + pressed before the plain focused item, or a remote's OK never shows
         the pressed fill (the first matching item wins). -->
    <item android:state_focused="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_accent" />
            <stroke android:width="2dp" android:color="@color/focus" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <stroke android:width="2dp" android:color="@color/focus" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
