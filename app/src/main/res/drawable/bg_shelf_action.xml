<!-- Shelf header action: quiet at rest, a focus ring only when the D-pad lands on it.
     The old permanent accent outline made See All louder than the shelf title. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_surface" />
            <stroke android:width="2dp" android:color="@color/focus" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
