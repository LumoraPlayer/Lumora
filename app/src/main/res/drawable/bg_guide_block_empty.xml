<!-- A guide row with no EPG: a faint ghost cell, not a programme. Keeps the row
     clickable and time-aligned while reading as "there is no data here". -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <stroke android:width="2dp" android:color="@color/focus" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/color_border_faint" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
