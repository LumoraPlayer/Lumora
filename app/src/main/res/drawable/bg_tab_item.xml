<!-- A primary tab is a pill, not a label with an underline. The selected tab keeps a quiet
     brand fill and border when the D-pad is elsewhere; focus adds the white ring without
     losing that fill. The old selected-only box was avoided because it competed with the
     focus ring, but the active destination now needs to be visible before focus lands. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_selected="true"
        android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_muted" />
            <stroke
                android:width="2dp"
                android:color="@color/focus" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_muted" />
            <stroke
                android:width="1dp"
                android:color="@color/primary" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <stroke
                android:width="2dp"
                android:color="@color/focus" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
