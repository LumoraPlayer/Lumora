<!-- The browse chrome's own surface: a slightly elevated canvas with a single hairline
     underline. It separates navigation from content without the heavy bar look of a
     floating toolbar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_elevated" />
        </shape>
    </item>
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="@color/color_border" />
        </shape>
    </item>
</layer-list>
