<!-- Docked Live TV preview band: a quiet glass shelf above the guide, not a card floating
     over the rows. Focusable now that pressing it opens the previewed channel, so the whole
     shelf carries a full focus border when the D-pad lands on it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <stroke
                android:width="3dp"
                android:color="@color/focus" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <stroke
                android:width="2dp"
                android:color="@color/focus" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <stroke
                android:width="2dp"
                android:color="@color/focus" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/color_border" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
