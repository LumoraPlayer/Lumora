<!-- Circular transport button for the player deck. Round rather than the toolbar's 12dp
     rectangle so the cluster reads as hardware beside the rectangular quick actions. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_accent" />
            <stroke
                android:width="3dp"
                android:color="@color/focus" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <stroke
                android:width="3dp"
                android:color="@color/focus" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_accent" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/color_border" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
