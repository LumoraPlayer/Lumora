<!-- Resume progress at the bottom edge of a poster: brand fill on a translucent track. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <!-- A dark track disappeared into the bottom scrim; a light one keeps the
                 bar legible even at 2% (a title watched for a few seconds). -->
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/primary_light" />
            </shape>
        </clip>
    </item>
</layer-list>
