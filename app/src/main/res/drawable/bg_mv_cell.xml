<?xml version="1.0" encoding="utf-8"?>
<!-- Multiview cell focus ring. The focused cell is also the audible pane, so this is the
     grid's only "where am I" signal on a TV remote - a full-strength stroke in the focus
     accent, transparent (but equally thick, so nothing shifts on focus change) when not. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="@color/focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
