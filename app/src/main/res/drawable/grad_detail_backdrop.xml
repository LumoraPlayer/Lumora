<!-- Scrim over the content-detail backdrop. The even wash keeps the artwork subdued
     without assuming which side the title sits on, so the same drawable works in RTL;
     the vertical gradient lets more of the still through behind the header and settles
     into the page surface behind the episode list. Both layers use the page's own
     surface colour, so the image reads as part of the detail screen rather than a
     separate, brighter panel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C0161B26" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#40161B26"
                android:centerColor="#A6161B26"
                android:endColor="#FA161B26" />
        </shape>
    </item>
</layer-list>
