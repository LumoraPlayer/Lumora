<!-- Touch press scrim for a multiview cell. It sits in the foreground so the video stays
     visible underneath; only the pressed state paints anything. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/scrim_cell_press" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
