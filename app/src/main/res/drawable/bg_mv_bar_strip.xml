<!-- The multiview action strip: an opaque canvas shelf under the grid. It reserves its own
     height instead of floating over the bottom row, so pane labels stay readable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="@color/color_border" />
        </shape>
    </item>
</layer-list>
