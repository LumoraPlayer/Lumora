<!-- The keyboard's one committed action. It stays the brand fill in every state so it
     remains distinguishable from the letter keys at a glance; focus adds the same light
     ring the rest of the app uses. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_light" />
            <stroke android:width="2dp" android:color="@color/focus" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_dark" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
