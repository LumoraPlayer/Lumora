<!-- The catalog ingest banner: a floating card over whatever is on screen, so a provider
     being added over existing content still narrates its size and progress. Elevated above
     the panes with a light border rather than the normal card surface, because it has to
     read as an overlay and not as another row of the screen underneath. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface_elevated" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="@color/primary_light" />
</shape>
