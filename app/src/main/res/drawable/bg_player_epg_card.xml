<!-- One card in the player's EPG rail. Focus wins over selected so the D-pad always has a
     visible position; selected without focus marks the programme airing right now. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <stroke
                android:width="2dp"
                android:color="@color/focus" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_muted" />
            <stroke
                android:width="2dp"
                android:color="@color/primary" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_elevated" />
            <stroke
                android:width="1dp"
                android:color="@color/color_border" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
