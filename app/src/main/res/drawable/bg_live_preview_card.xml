<!-- Preview card frame: the video fills it, the rounded outline clips the TextureView, and
     the channel/now overlay sits on the gradient inside. Transparent fill keeps the video
     visible while still giving clipToOutline a rounded outline to follow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="@color/color_border" />
    <corners android:radius="12dp" />
</shape>
