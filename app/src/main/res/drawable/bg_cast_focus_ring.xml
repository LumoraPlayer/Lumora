<!-- Focus ring for the small cast face, which now fills its cell instead of sitting inset in
     card chrome. Drawn over the photo, transparent while unfocused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="@color/focus" />
            <corners android:radius="@dimen/small_image_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/small_image_corner_radius" />
        </shape>
    </item>
</selector>
