    <dimen name="category_row_text">14sp</dimen>
    <!-- Tighter than the phone's 12dp/14dp: the category pill should hug its (now bold,
         larger) label rather than sit in a box sized for 10sp text. -->
    <dimen name="category_row_padding_vertical">6dp</dimen>
    <dimen name="category_row_padding_horizontal">9dp</dimen>
    <dimen name="category_star_size">26dp</dimen>
    <dimen name="guide_star_size">26dp</dimen>
    <dimen name="guide_channel_name_text">13sp</dimen>
    <dimen name="guide_channel_number_text">12sp</dimen>
    <dimen name="guide_channel_initial_text">13sp</dimen>
    <dimen name="guide_program_text">14sp</dimen>
    <dimen name="guide_program_info_title_text">15sp</dimen>
    <dimen name="guide_program_info_meta_text">12sp</dimen>
    <dimen name="guide_program_info_desc_text">14sp</dimen>
    <!-- Player EPG rail: the TV step. Two lines (slot/status, title) at a size readable from
