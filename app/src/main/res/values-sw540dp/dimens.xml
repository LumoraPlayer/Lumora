    <dimen name="player_epg_card_width">220dp</dimen>
    <dimen name="player_epg_card_height">46dp</dimen>
    <dimen name="player_epg_card_gap">12dp</dimen>
    <dimen name="player_epg_time_text">10sp</dimen>
    <dimen name="player_epg_title_text">13sp</dimen>
    <dimen name="mv_grid_padding">12dp</dimen>
    <dimen name="mv_bar_padding_horizontal">20dp</dimen>
    <dimen name="mv_bar_padding_vertical">12dp</dimen>
    <dimen name="mv_action_min_height">48dp</dimen>
    <dimen name="mv_action_text">14sp</dimen>
    <dimen name="mv_action_padding_horizontal">22dp</dimen>
    <dimen name="mv_cell_label_text">14sp</dimen>
    <dimen name="mv_cell_badge_text">11sp</dimen>
    <dimen name="mv_cell_label_max_width">260dp</dimen>
    <dimen name="mv_cell_error_icon">32dp</dimen>
    <dimen name="mv_cell_error_title_text">18sp</dimen>
    <dimen name="mv_cell_error_hint_text">12sp</dimen>
    <!-- Logo box and row height sized off the 13sp channel name rather than held at a fixed
         box: a 13sp line is ~18dp, so 30dp of logo plus the row's 4dp padding either side is
         all the height the content needs. The old 36dp/58dp pair was set when the type was
         larger and left a visible band of empty background above and below every name. -->
    <dimen name="guide_channel_logo_size">30dp</dimen>
    <dimen name="guide_row_min_height">40dp</dimen>
    <!-- The channel column is wide enough for typical channel names at the larger 13sp type,
         without spending more of the timeline than necessary. The guide header's spacer in
         activity_main.xml uses this same dimen, keeping the ruler aligned with the blocks. -->
    <dimen name="guide_channel_column_width">240dp</dimen>
    <!-- Long provider category names (and the "Show all categories" helper row) get a third
         line on TV; two was truncating them mid-word in the taller 14sp tier. -->
    <integer name="category_row_max_lines">3</integer>
    <!-- Narrower than the old 240dp: the rows are short labels with a count, and the width
         they were given came straight off the guide grid and the poster columns next to
         them. Long names wrap to a second line rather than taking more width - see
         item_category.xml. -->
    <dimen name="category_sidebar_width">180dp</dimen>

    <!-- Toolbar / tab bar / poster grid, all +~30% over the phone scale. Tab padding drops
         from 36dp to 22dp to keep the five-tab row inside the panel at the larger type.
         18dp (down from 22dp) since the chrome row gained a 12dp gap before the button
         cluster - the tabs must still fit next to the search/settings/refresh buttons
         without the last tab clipping or the scroller scrolling on a 1080p panel. -->
    <dimen name="tab_text">16sp</dimen>
    <!-- Live TV dropdown: remote targets and labels on the tab tier's scale. -->
    <dimen name="live_menu_width">240dp</dimen>
    <dimen name="live_menu_padding">10dp</dimen>
    <dimen name="live_menu_row_height">48dp</dimen>
    <dimen name="live_menu_row_padding_horizontal">14dp</dimen>
    <dimen name="live_menu_icon">20dp</dimen>
    <dimen name="live_menu_icon_gap">12dp</dimen>
    <dimen name="live_menu_text">16sp</dimen>
    <!-- The clock sits one step under the tab labels, as on the phone tier - but at the phone's
         11sp rather than the 14sp this tier used to give it. The chrome row has to carry six
         tabs, Search, the settings/refresh pair and the clock on ONE line at 960dp, and the
         clock is the one item there that can give way without anything pointing at it: it is
         a time, not a control, and it is the only one of the four that no other element
         refers to. -->
    <dimen name="toolbar_clock_text">11sp</dimen>
    <!-- Pills need room inside their rounded fill. The old 8dp was sized for an underline
         under bare labels; with a selected pill it left the label nearly touching the edge. -->
    <dimen name="tab_padding_horizontal">12dp</dimen>
    <dimen name="tab_padding_vertical">13dp</dimen>
    <!-- No gap at all before the Live TV tab: the brand mark sits at the row's edge and the
         tab's own 8dp padding is the space between them. The 6dp this used to add was room
         the one-line row cannot spare. -->
    <dimen name="tab_live_start_gap">0dp</dimen>
    <dimen name="poster_title_text">14sp</dimen>
    <!-- See the base bucket: TV is where the 8sp floor hurt most, so it sits only two steps
         under the ceiling here. -->
    <dimen name="poster_title_text_min">12sp</dimen>
    <dimen name="poster_title_outline_width">0.9dp</dimen>
    <dimen name="poster_badge_text">10sp</dimen>
    <!-- Five columns instead of six makes each card wider, so the fixed-height poster has to
         grow with it or the artwork ends up letterboxed. -->
    <dimen name="poster_image_height">160dp</dimen>
    <!-- Five per shelf row, not six. The artwork now fills the card rather than sitting in
         an 8dp inset frame; the height is the old 137dp image plus that frame's 16dp, so
         the row's outer size is unchanged. -->
    <dimen name="shelf_poster_width">104dp</dimen>
    <dimen name="shelf_poster_image_height">153dp</dimen>
    <!-- Cast row / person page at TV scale - see values/dimens.xml for the role of each.
         The face fills the cell; the name/role sit underneath. -->
    <dimen name="cast_photo_size">64dp</dimen>
    <dimen name="cast_cell_width">64dp</dimen>
    <dimen name="cast_name_text">11sp</dimen>
    <dimen name="cast_role_text">9sp</dimen>
    <dimen name="poster_image_corner_radius">18dp</dimen>
    <dimen name="detail_image_corner_radius">14dp</dimen>
    <!-- Detail header at sofa distance: the poster is a real cover card beside the title,
         not a thumbnail, and the title is the page's largest piece of type. -->
    <dimen name="detail_poster_width">120dp</dimen>
    <dimen name="detail_poster_height">180dp</dimen>
    <dimen name="detail_poster_elevation">8dp</dimen>
    <dimen name="detail_title_text">26sp</dimen>
    <dimen name="small_image_corner_radius">8dp</dimen>
    <dimen name="detail_actions_start_margin">16dp</dimen>
    <dimen name="person_photo_width">140dp</dimen>
    <dimen name="person_photo_height">210dp</dimen>
    <dimen name="content_body_text">17sp</dimen>

    <!-- Shelf headers sit above the posters and name the row, so they carry more weight than
         the 16sp/12sp they inherited from the shared scale. -->
    <dimen name="shelf_title_text">19sp</dimen>
    <dimen name="shelf_action_text">15sp</dimen>
    <!-- See All across a room, at D-pad distance - see values/dimens.xml for why these are
         dimens rather than literals in item_shelf.xml. Tightened with the phone tier: 18sp
         label is ~22dp tall, so 8dp vertical padding + a 40dp floor hugs it without losing
         the remote target. -->
    <dimen name="shelf_action_padding_h">16dp</dimen>
    <dimen name="shelf_action_padding_v">8dp</dimen>
    <dimen name="shelf_action_min_height">36dp</dimen>

    <!-- App-wide type scale, large-screen tier (see values/dimens.xml for the phone values
         and the rationale). Roughly +30% at the small end, tapering off at the top - a 48sp
         hero number is already large enough to read across a room, so scaling it by the same
         factor as 9sp caption text would just make it overwhelming. -->
    <dimen name="text_tiny">12sp</dimen>
    <dimen name="text_caption">13sp</dimen>
    <dimen name="text_body_s">14sp</dimen>
    <dimen name="text_body">16sp</dimen>
    <dimen name="text_body_l">17sp</dimen>
    <dimen name="text_subhead">18sp</dimen>
    <dimen name="text_subhead_l">19sp</dimen>
    <dimen name="text_title_s">21sp</dimen>
    <dimen name="text_title">23sp</dimen>
    <dimen name="text_display">30sp</dimen>
    <dimen name="text_hero">56sp</dimen>
    <!-- Up Next card's countdown number - smaller than text_display, see values/dimens.xml. -->
    <dimen name="up_next_countdown_text">15sp</dimen>

    <!-- 44dp, not 56dp: these hold a 24dp icon, and with the toolbar now wrap_content they
         are what makes it tall. A 56dp box around a 24dp glyph just padded the whole bar. -->
    <dimen name="toolbar_button_size">44dp</dimen>
    <!-- TV tab band = the tab ITEM height, measured on a 1920px Fire TV: a tab item
         renders 102px = 51dp (tab_padding_vertical 13dp x2 + 20dp icon + tab_text 17sp
         label line). The search pill previously used match_parent, which overshot to the
         scroller's full height and read oversized next to the tabs. If the tab internals
         change, recalibrate this to the tab item's rendered height. -->
    <!-- TV tier: tight edge for the icon-only settings/refresh pair - 18dp tab padding
         around a 20dp icon rendered the measured 56dp-wide empty capsules. 10dp hugs the
         icon while staying a reachable remote target inside the 51dp-tall band.
         6dp now: the chrome row has to carry six tabs, Search, the pair AND the clock on
         one line at 960dp, and every dp here is a dp the buttons lose. The icon itself is
         still 20dp, so the target barely changes. -->
    <dimen name="chrome_button_padding_h">6dp</dimen>
    <dimen name="chrome_button_min_size">48dp</dimen>
    <!-- Keep the brand inside the TV toolbar's safe inset; unlike the phone tier it is not
         pulled toward the screen bezel. -->
    <dimen name="toolbar_brand_translate_x">0dp</dimen>
    <!-- The toolbar's top padding supplies the TV overscan-safe inset. -->
    <dimen name="toolbar_brand_translate_y">0dp</dimen>
    <!-- 24dp rather than 28dp: the chrome row has to carry six tabs, Search, the
         settings/refresh pair and the clock on one line at 960dp, and every dp here is a dp
         the buttons lose. -->
    <dimen name="toolbar_padding_horizontal">24dp</dimen>
    <dimen name="toolbar_padding_top">4dp</dimen>
    <!-- The brand mark: 36dp rather than 40dp, for the same reason as the row's horizontal
         padding - it is a mark, not a label, and it reads the same two dp smaller. -->
    <dimen name="toolbar_brand_size">36dp</dimen>
    <!-- The gap between the last tab and the settings/refresh pair. 12dp rather than the
         base tier's 20dp: the pair sits at the end of the same one-line row, and the gap
         only has to separate the two groups, not set them in different rooms. -->
    <dimen name="chrome_cluster_gap">12dp</dimen>
    <!-- The gap between two chrome pills, and the chrome row's own end padding: 2dp and
         6dp, both squeezed for the same one-line reason - the row carries six tabs, Search,
         the settings/refresh pair and the clock at 960dp. 6dp of end padding still covers a
         focused pill's 1.06x scale at the row's edges. -->
    <dimen name="chrome_pill_gap">6dp</dimen>
    <dimen name="chrome_row_padding_h">6dp</dimen>
    <!-- The icon-to-label gap inside a tab pill. 5dp rather than the base tier's 8dp, for the
         same one-line reason - the icon and its label stay a pair, they just sit closer. -->
    <dimen name="tab_label_gap">5dp</dimen>
    <dimen name="settings_outer_padding_horizontal">28dp</dimen>
    <dimen name="settings_outer_padding_vertical">16dp</dimen>
    <dimen name="player_controls_safe_horizontal_inset">28dp</dimen>
    <dimen name="player_controls_safe_vertical_inset">16dp</dimen>
    <dimen name="player_controls_safe_margin">28dp</dimen>
    <!-- TV step of the player deck. The transport keeps a 48dp D-pad target and the play
         button grows to sofa-distance weight; quick actions use the same 56dp height so the
         deck's two rows never look like different components. -->
    <dimen name="player_transport_button_size">48dp</dimen>
    <dimen name="player_play_button_size">60dp</dimen>
    <dimen name="player_transport_gap">6dp</dimen>
    <dimen name="player_seek_height">36dp</dimen>
    <dimen name="player_quick_action_height">56dp</dimen>
    <dimen name="player_quick_action_gap">6dp</dimen>
    <dimen name="player_quick_action_icon_size">22dp</dimen>
    <dimen name="player_quick_action_title_text">12sp</dimen>
    <dimen name="player_quick_action_value_text">13sp</dimen>
    <dimen name="player_option_tile_min_height">60dp</dimen>
    <dimen name="player_option_title_text">16sp</dimen>
    <dimen name="player_option_value_text">13sp</dimen>
    <!-- TV tier of the toolbar cluster spacing - see values/dimens.xml. Slightly wider than
         phone: the buttons are aimed at a remote across a room, and the panel has room to
         spare at 960dp wide. -->
    <dimen name="toolbar_button_gap">8dp</dimen>
    <!-- Same 10dp as phone: the search pill's content is centred in its own box and the
         surrounding gaps are what carry the extra TV air, so growing this too would push the
         pill's label away from its icon rather than the cluster apart. -->

    <!-- Search doesn't need the whole panel: a centred 820dp column holds the keyboard and a
         two-up results grid without either running to the bezels. -->
    <dimen name="search_panel_width">820dp</dimen>
    <dimen name="search_panel_padding">20dp</dimen>
    <dimen name="search_keyboard_width">300dp</dimen>
    <dimen name="keyboard_key_height">46dp</dimen>
    <dimen name="keyboard_key_gap">4dp</dimen>
    <dimen name="keyboard_key_text">18sp</dimen>
    <dimen name="keyboard_action_text">13sp</dimen>
    <!-- TV tier of the search zone spacing - see values/dimens.xml. Roomier than phone so the
         three zones (header / keyboard / results) read as separate blocks at sofa distance. -->
    <dimen name="search_section_gap">16dp</dimen>
    <dimen name="search_column_gap">16dp</dimen>
    <!-- Sized so search shows two rows of four without scrolling. The grid gets roughly
         305dp of height (the slot, less the toolbar, tab bar, panel padding, query row and
         status line), and a card costs its artwork plus 16dp of card padding and 16dp of
         margin - so 118dp of poster is the most that fits twice over. Four columns across
         the ~470dp beside the keyboard gives each card ~85dp of artwork width, which makes
         these slightly squatter than 2:3; centerCrop absorbs that. -->
    <dimen name="search_poster_image_height">110dp</dimen>
    <!-- TV tier of the search inner-row spacing (status / recents / filters / grid) and the
         filter-chip gap - roomier than phone, same +2dp as search_section_gap's step. -->
    <dimen name="search_row_gap">10dp</dimen>
    <dimen name="search_chip_gap">10dp</dimen>

    <dimen name="home_search_bar_width">560dp</dimen>

    <!-- Sports board, TV tier - same +~30% step as the rest of this file. -->
    <dimen name="sports_row_min_height">78dp</dimen>
    <dimen name="sports_time_column_width">84dp</dimen>
    <dimen name="sports_row_gap">12dp</dimen>
    <dimen name="sports_logo_size">30dp</dimen>
    <dimen name="sports_channel_name_max_width">210dp</dimen>
    <dimen name="sports_score_box_min_width">34dp</dimen>
    <dimen name="sports_notice_padding">20dp</dimen>

    <!-- Live now cards, same step as the rest of this file (see values/dimens.xml for what the
         names are). The card's floor is generous on purpose: a 720p/1080p set is the narrowest
         thing that still gets two to a line. -->
    <dimen name="sports_live_channel_name_max_width">130dp</dimen>
    <dimen name="sports_live_logo_size">26dp</dimen>
    <dimen name="sports_live_grid_gap">24dp</dimen>
    <dimen name="sports_live_card_min_width">220dp</dimen>
</resources>
