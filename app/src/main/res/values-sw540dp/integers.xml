<resources>
    <!-- Five posters per row on large screens. The width-derived span put six across a TV
         panel, which left each card (and its title) too small at viewing distance.
         See values-sw540dp/dimens.xml for why this is keyed on smallest-width, not uiMode. -->
    <integer name="poster_grid_max_span">5</integer>

    <!-- Search results share the panel with the keyboard, so this counts columns in the
         ~430dp left over, not across the screen. Six columns keeps each tile a thumbnail:
         four drew posters large enough to crowd out the second row on a TV. -->
    <integer name="search_results_span">6</integer>
</resources>
