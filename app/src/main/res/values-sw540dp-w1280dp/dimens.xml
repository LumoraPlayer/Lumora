<!-- Large screens (4K TVs, ~1280dp+ wide) get smaller, denser posters: narrower grid
     columns so more fit per row, shorter poster cards, and a higher column cap. The
     sw540dp TV bucket keeps the big-poster look on smaller sets (720p/1080p), so a small
     TV shows fewer, larger posters and a big TV shows more, smaller ones. -->
<!-- The directory carries sw540dp *and* w1280dp deliberately. Android weighs smallestWidth
     before available width, so a plain values-w1280dp was eliminated at the sw step on every
     device that also matched values-sw540dp - which defines all the same names, making the
     whole file dead. Qualifying it with both keeps it in the running through the sw step and
     lets the width qualifier decide, which is what "a TV wider than 1280dp" meant all along. -->
<resources>
    <dimen name="poster_grid_min_column_width">80dp</dimen>
    <dimen name="poster_image_height">88dp</dimen>
    <dimen name="shelf_poster_width">104dp</dimen>
    <dimen name="shelf_poster_image_height">137dp</dimen>
    <dimen name="search_poster_image_height">77dp</dimen>

    <!-- Settings text: the sw540dp bucket (720p/1080p sets) already steps these up from the
         phone base; a 4K set sits further from the sofa than either, so it gets the largest
         step of all. Without this the Settings UI fell back to the phone base (8-11sp). -->
    <dimen name="settings_text_micro">10sp</dimen>
    <dimen name="settings_text_caption">12sp</dimen>
    <dimen name="settings_text_body">13sp</dimen>
    <dimen name="settings_text_subtitle">14sp</dimen>
    <dimen name="settings_text_section">16sp</dimen>
    <dimen name="settings_text_title">19sp</dimen>

    <!-- Chrome row: the roomier metrics. The sw540dp bucket has to squeeze the tabs, the
         clock and the settings/refresh pair onto ONE line on a 960dp-wide panel, and that
         squeeze costs the pills their air. A set this wide has ~300dp to spare, so it keeps
         the spacing the chrome had before the squeeze - the clock reads as the second step
         under the tab labels again, the pills keep their 10dp edges, and the brand mark stays
         full size. -->
    <dimen name="toolbar_clock_text">14sp</dimen>
    <dimen name="tab_padding_horizontal">10dp</dimen>
    <dimen name="tab_label_gap">8dp</dimen>
    <dimen name="tab_live_start_gap">6dp</dimen>
    <dimen name="chrome_button_padding_h">10dp</dimen>
    <dimen name="chrome_cluster_gap">20dp</dimen>
    <dimen name="chrome_pill_gap">3dp</dimen>
    <dimen name="chrome_row_padding_h">10dp</dimen>
    <dimen name="toolbar_padding_horizontal">28dp</dimen>
    <dimen name="toolbar_brand_size">40dp</dimen>

    <!-- Settings content inset, unchanged from before the sw540dp squeeze. The 200dp inset
         was only ever crushing the layout on a ~960dp panel, where it left a ~500dp strip of
         settings down the middle of the screen; on a panel this wide the column is roomy
         either way, and a small inset here would leave cards and input fields running the
         best part of two metres of background. -->
    <dimen name="settings_content_inset">200dp</dimen>
</resources>
