<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Settings nav rail row (icon chip + label). The background carries the selected/
         focused states, so rows only declare their content. -->
    <style name="Widget.Lumora.SettingsNavRow" parent="@android:style/Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/settings_nav_row_min_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">@dimen/settings_gap</item>
        <item name="android:background">@drawable/nav_rail_item_glass</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:stateListAnimator">@animator/focus_scale_flat</item>
        <item name="android:layout_marginBottom">@dimen/settings_gap_xs</item>
    </style>

    <style name="Widget.Lumora.SettingsNavLabel" parent="@android:style/Widget">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/settings_gap</item>
        <item name="android:textColor">@color/nav_label_color</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">@dimen/settings_text_subtitle</item>
        <!-- Two lines rather than an ellipsis: translated labels are longer than the English
             ones and a clipped section name is worse than a slightly taller rail row. -->
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Small all-caps group heading inside the settings rail. -->
    <style name="Widget.Lumora.SettingsNavGroup" parent="@android:style/Widget" tools:targetApi="28">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/settings_nav_group_indent</item>
        <item name="android:layout_marginEnd">@dimen/settings_gap_m</item>
        <item name="android:layout_marginTop">@dimen/settings_gap_l</item>
        <item name="android:layout_marginBottom">@dimen/settings_gap_xs</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/settings_text_caption</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:accessibilityHeading">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Group heading inside a settings pane, matching the rail headings. -->
    <style name="TextAppearance.Lumora.SettingsGroupLabel" parent="@android:style/TextAppearance" tools:targetApi="28">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/settings_text_caption</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <!-- Settings section title. accessibilityHeading is a platform attribute from API 28:
         older ROMs ignore it (the views still read as headings via the text itself), so it
         is marked rather than dropped - it is what keeps TalkBack's heading navigation
         useful on the 9+ devices the app supports. -->
    <style name="TextAppearance.Lumora.SettingsTitle" parent="@android:style/TextAppearance" tools:targetApi="28">
        <item name="android:textSize">@dimen/settings_text_title</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="TextAppearance.Lumora.SettingsSubtitle" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/settings_text_caption</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingBottom">@dimen/settings_gap_l</item>
    </style>

    <!-- Component styles -->
    <style name="Widget.Lumora.PrimaryButton" parent="@android:style/Widget">
        <item name="android:background">@drawable/bg_play_button</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Widget.Lumora.SecondaryButton" parent="@android:style/Widget">
        <item name="android:background">@drawable/bg_outline_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- LumoraDialog: the app's own popup chrome (see ui/dialog/LumoraDialog.kt) -->
    <style name="Widget.Lumora.DialogButton" parent="@android:style/Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:background">@drawable/bg_outline_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">104dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:stateListAnimator">@animator/focus_scale</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_subhead</item>
    </style>

    <style name="Widget.Lumora.DialogButton.Primary">
        <item name="android:background">@drawable/bg_dialog_button_primary</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>

</resources>
