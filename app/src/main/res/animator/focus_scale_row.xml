<!-- Focus pop for full-width rows (episode/download rows): a subtle 1.03x instead of
     the 1.06x focus_scale cards use. A full-width row scaled 1.06x overhangs the
     screen on both sides and the root layout clips it, so the focused row read as
     cut off left and right; 1.03x plus the row background's own focus ring reads
     just as clearly and stays on screen. The Z lift matches focus_scale so the
     row still draws above its siblings. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="160"
                android:valueTo="1.03"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="160"
                android:valueTo="1.03"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="160"
                android:valueTo="12"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="160"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="160"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="160"
                android:valueTo="0"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
